# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Swift Package Manager build cache (leaks in from sibling app-swift tooling)
.build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
data/
dev.db
dev.db-*

# Postgres-flavored schema mirror, regenerated on every dev/build by
# scripts/generate-pg-schema-mirror.ts — never hand-edited, never committed.
/src/lib/db/schema-pg/

# site backups + export bundles (never commit a site's data)
backups/
*.tar.gz

# Own Your Site CLI runtime state (license activation + update manifest)
.own-your-site/

# Playwright e2e ephemeral output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
