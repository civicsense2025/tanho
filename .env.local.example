ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=your-jwt-signing-secret-at-least-32-chars

# DB_PROVIDER selects the storage backend: turso (default) | postgres | mongodb
# DB_PROVIDER=turso

# Local dev (default — no config needed)
# TURSO_DATABASE_URL=file:./db/portfolio.db

# Production (Turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Postgres / Supabase (DB_PROVIDER=postgres)
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# MongoDB (DB_PROVIDER=mongodb)
# MONGODB_URL=mongodb://user:pass@host:27017
# MONGODB_DB=cms

# Content write-through (production only -- local dev writes content/ files
# directly). GITHUB_TOKEN needs Contents: Read and write on this repo only.
# CONTENT_PROVIDER=fs forces the local-fs write path even when NODE_ENV=production.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# File uploads (production only -- local dev writes to public/uploads/
# directly, same CONTENT_PROVIDER=fs override applies here too)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
