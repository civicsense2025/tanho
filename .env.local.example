# Admin login password. Prefer ADMIN_PASSWORD_HASH below so no plaintext password
# lives in the environment; if the hash is set it takes precedence over this.
ADMIN_PASSWORD=your-secure-password
# Optional: SHA-256 (hex) of the admin password. When set, the login compares
# hashes in constant time and ADMIN_PASSWORD is ignored. Generate with:
#   printf '%s' 'your-secure-password' | openssl dgst -sha256 -r | cut -d" " -f1
# ADMIN_PASSWORD_HASH=
ADMIN_SECRET=your-jwt-signing-secret-at-least-32-chars

# Optional admin-login brute-force tuning (defaults: 5 attempts, 900s lockout).
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_LOCKOUT_SECONDS=900

# Encrypts secret values (API keys/tokens) saved via /admin/settings, at rest in the DB.
# Separate from ADMIN_SECRET so rotating one doesn't invalidate the other. Generate with:
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=your-32-byte-base64-key

# Absolute origin (no trailing slash) used to build canonical URLs, sitemap.xml, robots.txt,
# and JSON-LD -- when an entity has no relative canonicalUrl override, this is prefixed onto it.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Branding / instance identity (src/config/site.config.ts, src/lib/settings.ts)
# PREFER /admin/settings over editing these -- it writes to the DB and takes effect
# immediately, no rebuild/redeploy. These env vars are now only the LEGACY fallback,
# read when no /admin/settings value has been saved for that field yet, so existing
# deployments configured before /admin/settings existed keep working unchanged.
# NEXT_PUBLIC_ vars are inlined at build time and exposed to the browser.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_NAME=Your Name or Brand
# NEXT_PUBLIC_SITE_TITLE=Your Name — What You Do
# NEXT_PUBLIC_SITE_DESCRIPTION=One-sentence site description for <meta> and og:description.
# NEXT_PUBLIC_SITE_AUTHOR=Your Name        # Person/author name in JSON-LD
# NEXT_PUBLIC_SITE_TAGLINE=Optional one-line positioning statement.
# NEXT_PUBLIC_SITE_LOCALE=en               # BCP-47 locale for <html lang>

# Build/serve mode: dynamic (runtime DB adapters, default) | static (SSG/file content)
# NEXT_PUBLIC_SITE_MODE=dynamic

# Theme (re-skins the whole app via the semantic design tokens — no code edits).
# Mode: system (follow OS, default — preserves auto dark mode) | light | dark
# NEXT_PUBLIC_THEME_MODE=system
# NEXT_PUBLIC_THEME_ACCENT=#6e2b32       # hex; overrides the primary accent
# NEXT_PUBLIC_THEME_ACCENT_2=#585c34     # hex; overrides the secondary accent
# NEXT_PUBLIC_THEME_FONT=Inter, sans-serif  # overrides the sans-serif stack

# Optional feature modules (true/1 to enable). Off-by-default flags gate additive
# modules; the base template ships without them and pays no code-path cost until enabled.
# NEXT_PUBLIC_FEATURE_GUIDES=true          # migration guides + resources (on by default)
# NEXT_PUBLIC_FEATURE_PAYMENTS=false       # reader-facing payments (their Stripe)
# NEXT_PUBLIC_FEATURE_AI=false             # AI-assisted authoring
# NEXT_PUBLIC_FEATURE_NEWSLETTER=false     # posts/issues, subscribers, RSS

# Search Console + analytics (both optional; unset = no verification tag, no script loaded).
# GSC: Search Console property -> Settings -> Ownership verification -> HTML tag method ->
# paste just the content="..." value here, not the whole <meta> tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-gsc-verification-token
# GA4: Admin -> Data Streams -> your web stream -> Measurement ID (starts with "G-").
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# DB_PROVIDER selects the storage backend: turso (default) | postgres | mongodb
# DB_PROVIDER=turso

# Local dev (default — no config needed)
# TURSO_DATABASE_URL=file:./db/portfolio.db

# Production (Turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Postgres / Supabase (DB_PROVIDER=postgres)
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# MongoDB (DB_PROVIDER=mongodb)
# MONGODB_URL=mongodb://user:pass@host:27017
# MONGODB_DB=cms

# Content write-through (production only -- local dev writes content/ files
# directly). GITHUB_TOKEN needs Contents: Read and write on this repo only.
# CONTENT_PROVIDER=fs forces the local-fs write path even when NODE_ENV=production.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# File uploads (production only -- local dev writes to public/uploads/
# directly, same CONTENT_PROVIDER=fs override applies here too)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Newsletter email delivery (only when NEXT_PUBLIC_FEATURE_NEWSLETTER=true). The template does
# not send mail itself -- bring your own ESP. Unset = "noop" provider (logs, no send), so local
# dev and static builds work without keys. Keys are server-only (never NEXT_PUBLIC_).
# EMAIL_PROVIDER=resend            # resend | postmark | noop (default)
# EMAIL_FROM=newsletter@your-domain.com
# RESEND_API_KEY=re_...            # when EMAIL_PROVIDER=resend
# POSTMARK_SERVER_TOKEN=...        # when EMAIL_PROVIDER=postmark

# Content scheduling: publishes scheduled entries on the cron defined in vercel.ts. Vercel
# auto-attaches this as a Bearer token to its own cron request -- no manual header wiring needed.
# Required in production (the route refuses to start without it).
# CRON_SECRET=<32+ random characters>
