{
  "name": "oys-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env -r ./seed/loaders/css-stub.cjs seed/neutral.ts",
    "seed:reset": "rm -f data/dev.db data/dev.db-wal data/dev.db-shm && npm run db:migrate && npm run seed",
    "seed:demo": "tsx --env-file-if-exists=.env -r ./seed/loaders/css-stub.cjs seed/demo-tanho.ts",
    "seed:sample": "tsx --env-file-if-exists=.env -r ./seed/loaders/css-stub.cjs seed/sample.ts",
    "import": "tsx --env-file-if-exists=.env -r ./seed/loaders/css-stub.cjs seed/import.ts",
    "backup": "bash scripts/backup.sh",
    "check:white-label": "bash scripts/check-white-label.sh"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "geist": "^1.7.2",
    "isomorphic-dompurify": "^3.18.0",
    "marked": "^18.0.5",
    "next": "16.2.10",
    "node-html-parser": "^8.0.4",
    "pg": "^8.22.0",
    "postcss": "^8.4.31",
    "re2": "^1.25.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5",
    "stripe": "^22.3.0",
    "tldts": "^7.4.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "lottie-web": "^5.13.0"
  }
}
